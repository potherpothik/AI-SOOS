# Copy to .env. Never commit .env. Replace the local defaults before any shared deploy.
AISOOS_ENVIRONMENT=development
AISOOS_DATABASE_URL=postgresql+psycopg://aisoos:aisoos@localhost:5432/aisoos
AISOOS_REDIS_URL=redis://localhost:6379/0
AISOOS_MONTHLY_BUDGET_USD=50
AISOOS_PER_PROJECT_BUDGET_USD=10
AISOOS_MAX_TASK_INPUT_TOKENS=200000
AISOOS_MAX_TASK_OUTPUT_TOKENS=40000
AISOOS_MAX_TASK_RETRIES=2
AISOOS_WORKSPACE_BACKEND=local
AISOOS_PROMPT_CACHE=false
AISOOS_COMPRESS_CONTEXT=false
AISOOS_RETENTION_HOURS=24
AISOOS_RUN_SEMGREP=true

# Leave blank. Install and generation do not ask for a model API key.
AISOOS_MODEL_API_KEY=
AISOOS_MODEL_NAME=
# Leave blank until a step opens a pull request. The API names this variable then.
AISOOS_GITHUB_TOKEN=
